{
  "name": "eins",
  "version": "0.1.0",
  "private": true,
  "description": "React boilerplate for SPA, PWA and Electron",
  "author": "",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode spa",
    "dev:spa": "vite --mode spa",
    "dev:pwa": "vite --mode pwa",
    "dev:electron": "vite --mode electron",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:spa",
    "build:spa": "npm run typecheck && vite build --mode spa",
    "build:pwa": "npm run typecheck && vite build --mode pwa",
    "build:electron": "npm run typecheck && vite build --mode electron",
    "build:all": "npm run build:spa && npm run build:pwa && npm run build:electron",
    "package:electron": "npm run build:electron && electron-builder",
    "package:electron:dir": "npm run build:electron && electron-builder --dir",
    "preview:spa": "vite preview --mode spa --port 4173",
    "preview:pwa": "vite preview --mode pwa --port 4174",
    "test": "playwright test"
  },
  "build": {
    "appId": "com.example.eins",
    "productName": "Eins",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@tanstack/react-router": "^1.170.39",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
